    {
      "mechanism": "sentientos/signed_strategic.py:SshStrategicSigner",
      "classification": "artifact_signing",
      "reuse_decision": "requires_refactor_before_reuse",
      "reason": "OpenSSH ssh-keygen -Y subprocesses, temporary files, a configured private-key path, an allowed-signers file, and hash-chain artifact semantics are operationally coupled to strategic artifacts rather than a persistent purpose-scoped root issuer."
    },
