      "classification": "self_binding_integrity_only",
      "reuse_decision": "incompatible_semantics",
      "reason": "It seals report evidence but does not establish a separately custodied asymmetric root issuer."
    },
    {
      "mechanism": "sentientos/attestation.py",
      "classification": "self_binding_integrity_only",
      "reuse_decision": "reuse_pattern_only",
      "reason": "Canonicalization and envelope hashing patterns are useful, but hashes alone do not authenticate an issuer."
    },
    {
      "mechanism": "nacl/signing.py",
      "classification": "compatibility_stub",
      "reuse_decision": "must_not_use",
      "reason": "It computes SHA-256(message || key), exposes the same bytes as signing and verification keys, and is not Ed25519; it MUST NOT be used as the security basis for causal-resource-principal issuer authentication."
    },
    {
      "mechanism": "keyring_backend.py",
      "classification": "credential_custody",
      "reuse_decision": "incompatible_semantics",
      "reason": "It is a legacy generic keyring facade and is not a purpose-scoped signing-key authority."
    },
    {
      "mechanism": "sentientos/external_model_execution_custody.py:OSKeyringCredentialBackend",
      "classification": "credential_custody",
      "reuse_decision": "reuse_pattern_only",
      "reason": "Its operator-provisioned, exact, read-only, fail-closed, short-lived secret-use boundary is precedent; external-model credentials and namespaces must not be reused as signing keys."
    }
  ],
