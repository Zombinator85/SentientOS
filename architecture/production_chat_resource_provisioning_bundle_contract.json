  },
  "consumer_contract": {
    "manifest_schema": "sentientos.production_chat_resource_provisioning:v1",
    "bundle_location": "local-model/resource-provisioning/<resource_provisioning_id>/",
    "required_filenames": [
      "manifest.json",
      "root-principal.json",
      "root-principal-provenance.json",
      "trusted-issuer-catalog.json",
      "principal-revocation-registry.json",
      "resource-policy.json",
      "resource-ledger.json"
    ],
    "manifest_fields": [
      "schema_version",
      "provisioning_id",
      "installation_identity",
      "resource_kind",
      "allocator_id",
      "principal_id",
      "principal_binding_digest",
      "provenance_digest",
      "trusted_issuer_catalog_version",
      "trusted_issuer_catalog_digest",
      "revocation_registry_version",
      "revocation_registry_digest",
      "resource_policy_digest",
      "allocation_id",
      "allocation_digest",
      "manifest_digest"
    ],
    "resource_kind": "governed_local_model_invocation_call_entitlement.v1",
    "allocator_id": "sentientos.governed_local_model_resource_allocator.v1",
    "provisioning_id_law": {
      "pattern": "[a-z0-9][a-z0-9._-]{0,127}\\Z",
      "forbids_double_dot": true,
      "forbidden_values": [
        "all",
        "any"
      ],
      "path_free": true
    },
    "performs_allocation_issuance": false,
    "restart_behavior": "loads the same exact pre-issued allocation and does not replenish entitlement"
  },
  "producer_contract": {
    "concept": "ProductionChatResourceProvisioningBundleProducer",
    "lifecycle": "explicit one-time provisioning creation separate from consumer startup, chat inference, and resource consumption",
    "trusted_inputs": [
      "authenticated InstallationStateHandle",
      "resource_provisioning_id",
      "pre-existing canonical CausalResourcePrincipal",
      "pre-existing RootPrincipalIssuerProvenance",
      "exact trusted-issuer catalog artifact",
      "exact principal-revocation registry artifact",
      "exact GovernedLocalModelResourcePolicy artifact",
      "GovernedLocalModelResourceBounds requested_bounds",
      "requested_not_before",
      "requested_not_after",
      "trusted current-time source"
    ],
    "forbidden_inputs": [
      "arbitrary filesystem path",
      "chat data",
      "session data",
      "request data"
    ],
    "destination": "local-model/resource-provisioning/<resource_provisioning_id>/ beneath the authenticated installation state",
    "concurrency": {
      "rule": "deterministic exclusive custody per resource_provisioning_id before create-only inspection and mutation",
      "mechanism": "authenticated installation-state locking machinery or equivalently bounded fixed lock derived only from resource_provisioning_id; never only a process-local mutex",
      "lock_location": "local-model/resource-provisioning-locks/<resource_provisioning_id>.lock",
      "grants_entitlement": false
    },
    "trusted_instant": {
      "count": 1,
      "use_for": [
        "principal validity",
        "provenance authentication",
        "currentness verification",
        "policy validity",
        "allocation issuance"
      ],
      "later_invocation_clock": false
    },
    "preflight_before_write": [
      "provisioning ID",
      "installation identity",
      "principal canonicality",
      "principal validity",
      "provenance structure",
      "provenance signature",
      "issuer trust",
      "revocation and currentness",
      "policy structure digest and validity",
      "requested bounds shape",
      "requested validity shape",
      "destination create-only status"
    ],
    "create_only": {
      "one_shot_id": true,
      "all_required_objects_must_be_absent": true,
      "fail_if_any_target_exists": true,
      "forbidden": [
        "overwrite",
        "merge",
        "repair in place",
        "append a second allocation",
        "silently reuse provisioning ID",
        "automatic retry after partial creation",
        "cleanup or delete"
      ]
    },
    "public_trust_chain": [
      "canonical CausalResourcePrincipal",
      "RootPrincipalIssuerProvenance",
      "exact trusted issuer catalog",
      "CryptographyEd25519RootIssuerSignatureVerifier",
      "RootIssuerProvenanceVerifier",
      "verifier-created AuthenticatedRootPrincipalEvidence"
    ],
    "currentness_chain": [
      "canonical CausalResourcePrincipal",
      "verifier-created AuthenticatedRootPrincipalEvidence",
      "exact ReadOnlyPrincipalRevocationRegistry",
      "PrincipalCurrentnessVerifier",
      "verifier-created CurrentAuthenticatedRootPrincipalEvidence"
    ],
    "allocation": {
      "issue_call": "GovernedLocalModelResourceAllocator.issue(...) exactly once",
      "request_fields": [
        "requested_bounds",
        "requested_not_before",
        "requested_not_after"
      ],
      "allocator_authoritative_for": [
        "principal binding",
        "currentness",
        "policy ceiling",
        "validity intersection",
        "allocation identity",
        "allocation digest"
      ],
      "post_issue_counts": {
        "allocation_count": 1,
        "attempt_count": 0,
        "resource_receipt_count": 0
      },
      "debits_allocation": false
    },
    "publication_order": [
      "validate all inputs",
      "secure exclusive provisioning-ID custody",
      "prove destination unused",
      "create durable ledger",
      "issue exactly one allocation",
      "durably create validated bundle artifacts",
      "construct exact existing consumer manifest",
      "durably create manifest.json LAST"
    ],
    "publication_marker": "manifest.json",
    "partial_failure": {
      "filesystem_wide_atomicity_claimed": false,
      "before_manifest": "bundle is not published and consumer fails closed",
      "retry_same_id_if_any_object_exists": false,
      "operator_options": [
        "select a new provisioning ID",
        "separately govern cleanup"
      ]
    },
    "artifact_fidelity": [
      "principal ID and binding digest",
      "provenance digest",
      "trust-catalog version and digest",
      "revocation-registry version and digest",
      "policy digest",
      "resource kind",
      "allocator ID"
    ],
    "forbidden_operations": [
      "mint_root",
      "mint_root_with_provenance",
      "renew root principal",
      "derive child principal",
      "alter principal epoch sponsor evidence or binding",
      "sign issuer provenance",
      "private signing-key custody",
      "trust administration",
      "policy administration",
      "resource consumption",
      "model inference or effect admission",
      "automatic startup integration"
    ],
    "restart_inequalities": [
      "ordinary daemon restart != producer invocation",
      "serving restart != producer invocation",
      "chat retry != producer invocation",
      "new conversation != producer invocation"
    ]
  },
