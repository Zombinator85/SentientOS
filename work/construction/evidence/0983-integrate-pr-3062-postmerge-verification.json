        "sphinx-build -b linkcheck -W",
        "default retry count",
        "Retry-After handling",
        "strict failure semantics"
      ],
      "retention_rule": "Keep the setting only if exact-candidate hosted acceptance passes and measured latency improves without reduced URL coverage."
