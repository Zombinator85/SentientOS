{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected multi-root semantic retrieval capacity audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "supersedes", "scope", "source_root_count",
    "source_roots", "atomic_snapshot", "stable_double_scan",
    "history_directory_count", "history_roots_with_records",
    "record_file_count", "duplicate_snapshot_copy_count",
    "unique_record_count", "unique_record_digest_count",
    "record_identity_conflict_count", "unique_records_by_task_family",
    "unique_records_without_task_family", "phase_a_min_independent_queries",
    "independent_source_reuse_permitted", "distinct_experience_shortfall",
    "capacity_is_upper_bound", "owner_admission_verified",
    "phase_a_eligible_record_count",
    "unique_records", "source_file_inventory", "source_inventory_digest",
    "audit_digest", "inference_performed", "learning_established", "authority"
  ],
  "properties": {
    "schema_version": { "const": "sentientos.semantic_retrieval_multi_root_capacity_audit:v1" },
    "supersedes": { "const": "artifacts/experiments/semantic-retrieval-capacity-20261123/corpus_capacity_audit_v3.json" },
    "scope": { "const": "structural_record_inventory_upper_bound_only" },
    "source_root_count": { "type": "integer", "minimum": 2 },
    "source_roots": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceRoot" }
    },
    "atomic_snapshot": { "const": false },
    "stable_double_scan": { "const": true },
    "history_directory_count": { "type": "integer", "minimum": 0 },
    "history_roots_with_records": { "type": "integer", "minimum": 0 },
    "record_file_count": { "type": "integer", "minimum": 0 },
    "duplicate_snapshot_copy_count": { "type": "integer", "minimum": 0 },
    "unique_record_count": { "type": "integer", "minimum": 0 },
    "unique_record_digest_count": { "type": "integer", "minimum": 0 },
    "record_identity_conflict_count": { "const": 0 },
    "unique_records_by_task_family": {
      "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "unique_records_without_task_family": { "type": "integer", "minimum": 0 },
    "phase_a_min_independent_queries": { "type": "integer", "minimum": 1 },
    "independent_source_reuse_permitted": { "const": false },
    "distinct_experience_shortfall": { "type": "integer", "minimum": 0 },
    "capacity_is_upper_bound": { "const": true },
    "owner_admission_verified": { "const": false },
    "phase_a_eligible_record_count": { "type": ["integer", "null"], "minimum": 0 },
    "unique_records": {
      "type": "array", "items": { "$ref": "#/$defs/uniqueRecord" },
      "uniqueItems": true
    },
    "source_file_inventory": {
      "type": "array", "items": { "$ref": "#/$defs/sourceFile" }
    },
    "source_inventory_digest": { "$ref": "#/$defs/prefixedDigest" },
    "audit_digest": { "$ref": "#/$defs/prefixedDigest" },
    "inference_performed": { "const": false },
    "learning_established": { "const": false },
    "authority": { "const": false }
  },
  "$defs": {
    "hexDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prefixedDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "recordId": { "type": "string", "pattern": "^devrec-[0-9a-f]{24}$" },
    "cycleId": { "type": "string", "pattern": "^rootless-cognition-cycle-[0-9a-f]{20}$" },
    "taskFamilies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "sourceRoot": {
      "type": "object", "additionalProperties": false,
      "required": ["source_root_id", "history_directory_count", "history_roots_with_records", "record_file_count", "unique_record_count"],
      "properties": {
        "source_root_id": { "$ref": "#/$defs/hexDigest" },
        "history_directory_count": { "type": "integer", "minimum": 0 },
        "history_roots_with_records": { "type": "integer", "minimum": 0 },
        "record_file_count": { "type": "integer", "minimum": 0 },
        "unique_record_count": { "type": "integer", "minimum": 0 }
      }
    },
    "uniqueRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_digest", "task_family_ids"],
      "properties": {
        "record_id": { "$ref": "#/$defs/recordId" },
        "record_digest": { "$ref": "#/$defs/prefixedDigest" },
        "task_family_ids": { "$ref": "#/$defs/taskFamilies" }
      }
    },
    "sourceFile": {
      "type": "object", "additionalProperties": false,
      "required": ["source_root_id", "cycle_id", "path", "record_id", "record_digest", "source_file_sha256", "task_family_ids"],
      "properties": {
        "source_root_id": { "$ref": "#/$defs/hexDigest" },
        "cycle_id": { "$ref": "#/$defs/cycleId" },
        "path": { "type": "string", "minLength": 1 },
        "record_id": { "$ref": "#/$defs/recordId" },
        "record_digest": { "$ref": "#/$defs/prefixedDigest" },
        "source_file_sha256": { "$ref": "#/$defs/hexDigest" },
        "task_family_ids": { "$ref": "#/$defs/taskFamilies" }
      }
    }
  }
}
