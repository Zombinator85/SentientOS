{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rootless Cycle Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "cycle_status",
    "file_count",
    "total_size_bytes",
    "files",
    "file_contents_included",
    "atomic_snapshot",
    "independent_signature",
    "inference_performed",
    "authority",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "sentientos.rootless_cycle_evidence_manifest:v1"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^rootless-cognition-cycle-[0-9a-f]{20}$"
    },
    "cycle_status": {
      "enum": ["completed", "incomplete"]
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483648
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 134217728
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "file_contents_included": {
      "const": false
    },
    "atomic_snapshot": {
      "const": false
    },
    "independent_signature": {
      "const": false
    },
    "inference_performed": {
      "const": false
    },
    "authority": {
      "const": false
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
