{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentientos:schema:federated-semantic-history-review-template:v1",
  "title": "SentientOS federated semantic history review template",
  "description": "Exhaustive blinded label slots bound to one federated query set and its pair packets. Template is not reviewer evidence until completed and validated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "query_set_id", "query_set_digest",
    "federated_manifest_digest", "reviewer_digest", "review_pair_digests",
    "annotations", "authority", "template_digest"
  ],
  "properties": {
    "schema_version": { "const": "sentientos.federated_semantic_history_review_template:v1" },
    "query_set_id": { "type": "string", "pattern": "^federated-queryset-[0-9a-f]{24}$" },
    "query_set_digest": { "$ref": "#/$defs/digest" },
    "federated_manifest_digest": { "$ref": "#/$defs/digest" },
    "reviewer_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "review_pair_digests": {
      "type": "array", "minItems": 1, "maxItems": 25000,
      "items": { "$ref": "#/$defs/digest" }
    },
    "annotations": {
      "type": "array", "minItems": 1, "maxItems": 25000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_digest", "record_ref_id", "record_digest", "label"],
        "properties": {
          "question_digest": { "$ref": "#/$defs/digest" },
          "record_ref_id": { "type": "string", "pattern": "^frec-[0-9a-f]{24}$" },
          "record_digest": { "$ref": "#/$defs/digest" },
          "label": { "const": null }
        }
      }
    },
    "authority": { "const": false },
    "template_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
