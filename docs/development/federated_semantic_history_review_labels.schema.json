{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentientos:schema:federated-semantic-history-review-labels:v1",
  "title": "SentientOS federated semantic history review labels",
  "description": "Human labels in exact template order. This input alone does not prove reviewer independence or label quality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "labels"],
  "properties": {
    "schema_version": { "const": "sentientos.federated_semantic_history_review_labels:v1" },
    "labels": {
      "type": "array", "minItems": 1, "maxItems": 25000,
      "items": { "enum": ["relevant", "inapplicable", "neither"] }
    }
  }
}
