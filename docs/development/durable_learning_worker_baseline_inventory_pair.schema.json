{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.local/schemas/durable_learning_worker_baseline_inventory_pair.schema.json",
  "title": "SentientOS durable-learning paired worker baseline inventory",
  "description": "Immutable protocol-scoped pair of condition baseline artifacts. Paired readiness is true only when both condition reports passed their baseline gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "protocol_digest", "condition_inventories", "paired_baseline_ready", "retention_contrast_eligible", "authority", "artifact_digest", "artifact_id"],
  "properties": {
    "schema_version": { "enum": ["sentientos.durable_learning_worker_baseline_inventory_pair:v1", "sentientos.durable_learning_worker_baseline_inventory_pair:v2"] },
    "protocol_id": { "type": "string", "pattern": "^devexp-durable-learning-protocol-[0-9a-f]{24}$" },
    "protocol_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "condition_inventories": {
      "type": "object", "additionalProperties": false,
      "required": ["relevant_experience_available", "relevant_experience_withheld"],
      "properties": {
        "relevant_experience_available": { "$ref": "#/$defs/artifactRef" },
        "relevant_experience_withheld": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "paired_baseline_ready": { "type": "boolean" },
    "baseline_runtime_setup": { "$ref": "#/$defs/setupArtifactRef" },
    "retention_contrast_eligible": { "const": false },
    "authority": { "const": false },
    "artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_id": { "type": "string", "pattern": "^devexp-durable-learning-worker-baseline-pair-[0-9a-f]{24}$" }
  },
  "$defs": {
    "setupArtifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^devexp-durable-learning-worker-baseline-setup-[0-9a-f]{24}$" },
        "artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^devexp-durable-learning-worker-baseline-[0-9a-f]{24}$" },
        "artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "sentientos.durable_learning_worker_baseline_inventory_pair:v2" } }, "required": ["schema_version"] },
      "then": { "required": ["baseline_runtime_setup"] }
    },
    {
      "if": { "properties": { "schema_version": { "const": "sentientos.durable_learning_worker_baseline_inventory_pair:v1" } }, "required": ["schema_version"] },
      "then": { "not": { "required": ["baseline_runtime_setup"] } }
    }
  ]
}
