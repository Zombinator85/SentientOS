{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.local/schemas/durable_learning_evaluation_v32.schema.json",
  "title": "Durable-learning evaluation v32 compatibility envelope",
  "description": "Validates the immutable v32 evaluation envelope used by protocols v5-v10. V11-only competence assessment fields are excluded; bounded descriptive metrics remain governed by their recomputation verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "protocol_digest", "outcome_refs",
    "report", "claims_posture", "authority", "evaluation_id",
    "evaluation_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "sentientos.durable_learning_evaluation:v32"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^devexp-durable-learning-protocol-[0-9a-f]{24}$"
    },
    "protocol_digest": { "$ref": "#/$defs/digest" },
    "outcome_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/outcomeRef" }
    },
    "report": { "$ref": "#/$defs/reportV32" },
    "claims_posture": {
      "const": "bounded_fixture_comparison_no_durable_learning_claim"
    },
    "authority": { "const": false },
    "evaluation_id": {
      "type": "string",
      "pattern": "^devexp-durable-learning-evaluation-[0-9a-f]{24}$"
    },
    "evaluation_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcomeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "outcome_digest"],
      "properties": {
        "outcome_id": {
          "type": "string",
          "pattern": "^devexp-durable-learning-outcome-[0-9a-f]{24}$"
        },
        "outcome_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "reportV32": {
      "type": "object",
      "required": [
        "schema_version", "protocol_id", "outcome_count",
        "durable_learning_established", "authority"
      ],
      "properties": {
        "schema_version": {
          "const": "sentientos.durable_learning_outcome_set_verification:v32"
        },
        "protocol_id": {
          "type": "string",
          "pattern": "^devexp-durable-learning-protocol-[0-9a-f]{24}$"
        },
        "outcome_count": { "type": "integer", "minimum": 1 },
        "durable_learning_established": { "const": false },
        "authority": { "const": false }
      },
      "not": {
        "required": ["withheld_acquisition_competence_assessment"]
      },
      "additionalProperties": true
    }
  }
}
