{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.invalid/schemas/historical_pair_identity_neutral_preload_binding.schema.json",
  "title": "SentientOS identity-neutral historical pair pre-load binding receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_plan_digest",
    "protocol_digest",
    "target_model_identity_digest",
    "binding_evidence",
    "model_loaded",
    "inference_performed",
    "learning_established",
    "authority",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "sentientos.historical_pair_identity_neutral_preload_binding:v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "protocol_digest": {
      "$ref": "#/$defs/digest"
    },
    "target_model_identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "binding_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "parity_audit_digest",
        "parity_audit_file_digest",
        "source_parity_reconstruction_verified",
        "allowlist_digest",
        "allowlist_file_digest",
        "selected_record_ids",
        "selected_record_digests",
        "authority",
        "inference_performed",
        "learning_established"
      ],
      "properties": {
        "status": {
          "const": "verified_identity_neutral_shared_history_binding"
        },
        "parity_audit_digest": {
          "$ref": "#/$defs/digest"
        },
        "parity_audit_file_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_parity_reconstruction_verified": {
          "const": true
        },
        "allowlist_digest": {
          "$ref": "#/$defs/digest"
        },
        "allowlist_file_digest": {
          "$ref": "#/$defs/digest"
        },
        "selected_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_record_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "authority": {
          "const": false
        },
        "inference_performed": {
          "const": false
        },
        "learning_established": {
          "const": false
        }
      }
    },
    "model_loaded": {
      "const": false
    },
    "inference_performed": {
      "const": false
    },
    "learning_established": {
      "const": false
    },
    "authority": {
      "const": false
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
