{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.local/schemas/durable_learning_profile_data_inventory_artifact.schema.json",
  "title": "SentientOS durable-learning profile-data inventory artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_digest",
    "branch_preflight_id",
    "branch_preflight_digest",
    "profile_pair_artifact_id",
    "profile_pair_artifact_digest",
    "condition",
    "profile_data_inventory",
    "worker_quiescence_verified",
    "snapshot_atomicity_verified",
    "profile_state_accounted",
    "registry_state_accounted",
    "retention_contrast_eligible",
    "authority",
    "artifact_digest",
    "artifact_id"
  ],
  "properties": {
    "schema_version": {
      "const": "sentientos.durable_learning_profile_data_inventory_artifact:v1"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^devexp-durable-learning-protocol-[0-9a-f]{24}$"
    },
    "protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "branch_preflight_id": {
      "type": "string",
      "pattern": "^devexp-durable-learning-branch-preflight-(?:v[2-6]-)?[0-9a-f]{24}$"
    },
    "branch_preflight_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_pair_artifact_id": {
      "type": "string",
      "pattern": "^devexp-durable-learning-appcontainer-profile-pair-[0-9a-f]{24}$"
    },
    "profile_pair_artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "condition": {
      "enum": [
        "relevant_experience_available",
        "relevant_experience_withheld"
      ]
    },
    "profile_data_inventory": {
      "$ref": "windows_appcontainer_profile_data_inventory.schema.json"
    },
    "worker_quiescence_verified": {
      "const": false
    },
    "snapshot_atomicity_verified": {
      "const": false
    },
    "profile_state_accounted": {
      "const": false
    },
    "registry_state_accounted": {
      "const": false
    },
    "retention_contrast_eligible": {
      "const": false
    },
    "authority": {
      "const": false
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^devexp-durable-learning-profile-data-inventory-[0-9a-f]{24}$"
    }
  }
}
