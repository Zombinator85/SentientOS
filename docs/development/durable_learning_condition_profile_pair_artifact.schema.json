{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.local/schemas/durable_learning_condition_profile_pair_artifact.schema.json",
  "title": "SentientOS durable-learning condition profile-pair store artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "protocol_digest",
    "branch_preflight_id", "branch_preflight_digest", "profile_pair",
    "profile_pair_digest", "authority", "artifact_digest", "artifact_id"
  ],
  "properties": {
    "schema_version": { "const": "sentientos.durable_learning_condition_profile_pair_artifact:v1" },
    "protocol_id": { "type": "string", "pattern": "^devexp-durable-learning-protocol-[0-9a-f]{24}$" },
    "protocol_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "branch_preflight_id": { "type": "string", "pattern": "^devexp-durable-learning-branch-preflight-(?:v[2-6]-)?[0-9a-f]{24}$" },
    "branch_preflight_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profile_pair": { "$ref": "windows_appcontainer_profile_pair.schema.json" },
    "profile_pair_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authority": { "const": false },
    "artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_id": { "type": "string", "pattern": "^devexp-durable-learning-appcontainer-profile-pair-[0-9a-f]{24}$" }
  }
}
