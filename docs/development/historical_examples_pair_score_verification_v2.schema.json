{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.invalid/schemas/historical_examples_pair_score_verification_v2.schema.json",
  "title": "SentientOS independent historical examples pair score verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_digest",
    "score_digest",
    "probe_count",
    "runtime_history_record_count",
    "runtime_history_record_set_digest",
    "runtime_history_receipt_count",
    "runtime_history_receipt_set_digest",
    "runtime_history_receipt_record_links_verified",
    "selected_history_record_receipts_verified",
    "correct_counts",
    "scoring_reconstructed_from_archived_receipts",
    "private_answer_key_reconstructed",
    "independent_scorer_attested",
    "learning_established",
    "authority",
    "verification_digest",
    "independent_recomputed_correct_counts",
    "independent_recomputed_outcomes_digest",
    "independent_receipt_digests",
    "independent_scorer_implementation_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "sentientos.historical_examples_pair_score_verification:v2"
    },
    "protocol_digest": {
      "$ref": "#/$defs/digest"
    },
    "score_digest": {
      "$ref": "#/$defs/digest"
    },
    "probe_count": {
      "type": "integer",
      "minimum": 1
    },
    "runtime_history_record_count": {
      "type": "integer",
      "minimum": 1
    },
    "runtime_history_record_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_history_receipt_count": {
      "type": "integer",
      "minimum": 0
    },
    "runtime_history_receipt_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_history_receipt_record_links_verified": {
      "const": true
    },
    "selected_history_record_receipts_verified": {
      "const": true
    },
    "correct_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examples_included",
        "examples_omitted"
      ],
      "properties": {
        "examples_included": {
          "type": "integer",
          "minimum": 0
        },
        "examples_omitted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scoring_reconstructed_from_archived_receipts": {
      "const": true
    },
    "private_answer_key_reconstructed": {
      "const": true
    },
    "independent_scorer_attested": {
      "const": true
    },
    "learning_established": {
      "const": false
    },
    "authority": {
      "const": false
    },
    "verification_digest": {
      "$ref": "#/$defs/digest"
    },
    "independent_recomputed_correct_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examples_included",
        "examples_omitted"
      ],
      "properties": {
        "examples_included": {
          "type": "integer",
          "minimum": 0
        },
        "examples_omitted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "independent_recomputed_outcomes_digest": {
      "$ref": "#/$defs/digest"
    },
    "independent_scorer_implementation_digest": {
      "$ref": "#/$defs/digest"
    },
    "independent_receipt_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examples_included",
        "examples_omitted"
      ],
      "properties": {
        "examples_included": {
          "$ref": "#/$defs/receiptDigest"
        },
        "examples_omitted": {
          "$ref": "#/$defs/receiptDigest"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
