{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.local/schemas/durable_learning_worker_baseline_interruption.schema.json",
  "title": "SentientOS durable-learning baseline worker interruption",
  "description": "Immutable record of partial baseline ACL setup or worker launch. It blocks automatic retry and does not attest effective access or isolation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "protocol_digest",
    "profile_pair_artifact_id", "profile_pair_artifact_digest",
    "runtime_access_setup", "baseline_read_access_setup", "failure_phase",
    "launch_call_returned", "worker_process_observations",
    "created_endpoint_conditions", "accepted_pipe_conditions",
    "cleanup_errors", "failure_type", "retry_blocked", "authority",
    "artifact_digest", "artifact_id"
  ],
  "properties": {
    "schema_version": { "const": "sentientos.durable_learning_worker_baseline_interruption:v1" },
    "protocol_id": { "type": "string", "pattern": "^devexp-durable-learning-protocol-[0-9a-f]{24}$" },
    "protocol_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profile_pair_artifact_id": { "type": "string", "minLength": 1 },
    "profile_pair_artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtime_access_setup": { "type": "object" },
    "baseline_read_access_setup": { "type": "object" },
    "failure_phase": { "enum": ["runtime_access_setup", "baseline_read_access_setup", "worker_pair_launch", "pipe_acceptance", "baseline_rpc", "cleanup"] },
    "launch_call_returned": { "type": "boolean" },
    "worker_process_observations": {
      "type": "object",
      "propertyNames": { "enum": ["relevant_experience_available", "relevant_experience_withheld"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["process_id", "process_creation_time_100ns", "observation_digest"],
        "properties": {
          "process_id": { "type": "integer", "minimum": 1 },
          "process_creation_time_100ns": { "type": "integer", "minimum": 1 },
          "observation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "created_endpoint_conditions": { "$ref": "#/$defs/conditions" },
    "accepted_pipe_conditions": { "$ref": "#/$defs/conditions" },
    "cleanup_errors": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "failure_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "retry_blocked": { "const": true },
    "authority": { "const": false },
    "artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_id": { "type": "string", "pattern": "^devexp-durable-learning-worker-baseline-interruption-[0-9a-f]{24}$" }
  },
  "$defs": {
    "conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["relevant_experience_available", "relevant_experience_withheld"] }
    }
  }
}
