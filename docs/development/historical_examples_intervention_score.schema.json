{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SentientOS historical examples intervention score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_digest",
    "answer_key_digest",
    "probe_count",
    "outcomes_by_arm",
    "paired_probe_outcomes",
    "correct_counts",
    "answered_counts",
    "coverage_basis_points",
    "confidence_brier_squared_error_sums",
    "confidence_scored_counts",
    "invocation_receipt_bindings",
    "owner_prompt_pair_preview_digest",
    "paired_delivery_verified",
    "inference_performed",
    "scoring_posture",
    "independent_scorer_attested",
    "learning_established",
    "authority",
    "score_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "sentientos.historical_examples_intervention_score:v2"
    },
    "protocol_digest": { "$ref": "#/$defs/digest" },
    "answer_key_digest": { "$ref": "#/$defs/digest" },
    "probe_count": { "type": "integer", "minimum": 1, "maximum": 128 },
    "outcomes_by_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examples_included", "examples_omitted"],
      "properties": {
        "examples_included": { "$ref": "#/$defs/outcomes" },
        "examples_omitted": { "$ref": "#/$defs/outcomes" }
      }
    },
    "paired_probe_outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/pairedOutcome" }
    },
    "correct_counts": { "$ref": "#/$defs/armCounts" },
    "answered_counts": { "$ref": "#/$defs/armCounts" },
    "coverage_basis_points": { "$ref": "#/$defs/armCoverage" },
    "confidence_brier_squared_error_sums": { "$ref": "#/$defs/armCounts" },
    "confidence_scored_counts": { "$ref": "#/$defs/armCounts" },
    "invocation_receipt_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examples_included", "examples_omitted"],
      "properties": {
        "examples_included": { "$ref": "#/$defs/receiptBinding" },
        "examples_omitted": { "$ref": "#/$defs/receiptBinding" }
      }
    },
    "owner_prompt_pair_preview_digest": { "$ref": "#/$defs/digest" },
    "paired_delivery_verified": { "const": true },
    "inference_performed": { "const": true },
    "scoring_posture": {
      "const": "same_process_answer_key_and_arm_labeled_receipts"
    },
    "independent_scorer_attested": { "const": false },
    "learning_established": { "const": false },
    "authority": { "const": false },
    "score_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "outcome": { "enum": ["correct", "incorrect", "abstained"] },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_binding_digest", "outcome"],
        "properties": {
          "probe_binding_digest": { "$ref": "#/$defs/digest" },
          "outcome": { "$ref": "#/$defs/outcome" },
          "brier_squared_error_basis_points_squared": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        }
      }
    },
    "pairedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_binding_digest",
        "examples_included",
        "examples_omitted"
      ],
      "properties": {
        "probe_binding_digest": { "$ref": "#/$defs/digest" },
        "examples_included": { "$ref": "#/$defs/outcome" },
        "examples_omitted": { "$ref": "#/$defs/outcome" }
      }
    },
    "armCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examples_included", "examples_omitted"],
      "properties": {
        "examples_included": { "type": "integer", "minimum": 0 },
        "examples_omitted": { "type": "integer", "minimum": 0 }
      }
    },
    "armCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examples_included", "examples_omitted"],
      "properties": {
        "examples_included": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "examples_omitted": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "receiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "request_id",
        "request_digest",
        "preview_request_digest",
        "prompt_digest",
        "output_digest"
      ],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "receipt_digest": { "$ref": "#/$defs/digest" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "preview_request_digest": { "$ref": "#/$defs/digest" },
        "prompt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "output_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
