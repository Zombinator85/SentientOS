{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentientos:schema:federated-archive-source-binding:v1",
  "title": "SentientOS federated archive source binding",
  "description": "Binds opaque federated source IDs to source-root identities and the independently replayed experience-anchor audit and exact source snapshots used to derive each archive corpus manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "federated_manifest_digest",
    "experience_anchor_audit_digest", "experience_anchor_verification_digest",
    "source_snapshot_count", "source_snapshot_digest", "sources",
    "model_invoked", "learning_established", "authority", "binding_digest"
  ],
  "properties": {
    "schema_version": { "const": "sentientos.federated_archive_source_binding:v1" },
    "federated_manifest_digest": { "$ref": "#/$defs/digest" },
    "experience_anchor_audit_digest": { "$ref": "#/$defs/digest" },
    "experience_anchor_verification_digest": { "$ref": "#/$defs/digest" },
    "source_snapshot_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "source_snapshot_digest": { "$ref": "#/$defs/digest" },
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_root_id", "record_count", "record_inventory_digest", "source_snapshot_count", "source_snapshot_digest"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^src-[0-9a-f]{24}$" },
          "source_root_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "record_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "record_inventory_digest": { "$ref": "#/$defs/digest" },
          "source_snapshot_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "source_snapshot_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "model_invoked": { "const": false },
    "learning_established": { "const": false },
    "authority": { "const": false },
    "binding_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
