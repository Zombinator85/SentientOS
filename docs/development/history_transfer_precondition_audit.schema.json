{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientos.local/schemas/history_transfer_precondition_audit.schema.json",
  "title": "Persisted history transfer precondition audit",
  "description": "Separates exact runtime snapshot-bound evidence from retrospective inspection of a final durable record; transport authentication without persisted external key-custody evidence does not establish an independent observer.",
  "type": "object",
  "required": [
    "schema_version", "measurement_scope", "inference_performed",
    "learning_claim_made", "skipped_probes_are_negative_results",
    "artifact_count", "valid_artifact_count", "artifact_error_count",
    "source_binding_valid_pattern_fact_count",
    "verified_source_pattern_fact_count",
    "retrospective_verified_source_fact_count",
    "runtime_snapshot_bound_pattern_match_count",
    "observer_key_custody_unverified_record_count",
    "record_snapshot_binding_status_counts", "runs"
  ],
  "properties": {
    "schema_version": {"const": "sentientos.history_transfer_precondition_audit:v5"},
    "measurement_scope": {"const": "persisted_artifact_readiness_summary"},
    "inference_performed": {"const": false},
    "learning_claim_made": {"const": false},
    "skipped_probes_are_negative_results": {"const": false},
    "artifact_count": {"type": "integer", "minimum": 0},
    "valid_artifact_count": {"type": "integer", "minimum": 0},
    "artifact_error_count": {"type": "integer", "minimum": 0},
    "source_binding_valid_pattern_fact_count": {"type": "integer", "minimum": 0},
    "verified_source_pattern_fact_count": {"type": "integer", "minimum": 0},
    "retrospective_verified_source_fact_count": {"type": "integer", "minimum": 0},
    "runtime_snapshot_bound_pattern_match_count": {"type": "integer", "minimum": 0},
    "observer_key_custody_unverified_record_count": {"type": "integer", "minimum": 0},
    "record_snapshot_binding_status_counts": {"type": "object"},
    "runs": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
